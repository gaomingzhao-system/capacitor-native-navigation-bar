{
  "compilerOptions": {
    /*
     * ES2017 is deliberate, not legacy: it is the runtime/browser output target
     * (see tsdown.config.ts), not related to the Node.js version used to build
     * this package. Capacitor's minimum supported Android System WebView is
     * version 55 (Bridge.MINIMUM_ANDROID_WEBVIEW_VERSION), which predates
     * optional chaining and nullish coalescing, so the emitted JS must still be
     * downleveled to ES2017 even though building requires Node.js 22+.
     */
    "target": "ES2017",
    "lib": ["DOM", "DOM.Iterable", "ES2017"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "*.config.ts"]
}
