{
  "name": "capacitor-native-navigation-bar",
  "version": "2.0.0",
  "description": "Capacitor 7 plugin (ESM-only) for native navbar, tabbar, safe-area handling, and WebView snapshot transitions.",
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "liquid-glass",
    "native-navigation",
    "navbar",
    "safe-area",
    "tabbar"
  ],
  "homepage": "https://github.com/gaomingzhao666/capacitor-native-navigation-bar#readme",
  "bugs": {
    "url": "https://github.com/gaomingzhao666/capacitor-native-navigation-bar/issues"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaomingzhao666/capacitor-native-navigation-bar.git"
  },
  "files": [
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/src/main/",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "CapacitorNativeNavigationBar.podspec",
    "Package.swift",
    "LICENSE",
    "NOTICE",
    "PLATFORM.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run lint:fmt && pnpm run lint:js && pnpm run typecheck && pnpm run check:wiring",
    "lint:js": "oxlint --deny-warnings",
    "lint:fmt": "oxfmt --check .",
    "fmt": "oxfmt . && oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run verify:web && pnpm run verify:ios && pnpm run verify:android",
    "verify:web": "pnpm run lint && pnpm run test && pnpm run build && pnpm run check:package",
    "verify:ios": "xcodebuild -scheme CapacitorNativeNavigationBar -destination generic/platform=iOS build",
    "verify:ios:test": "xcodebuild test -scheme CapacitorNativeNavigationBar -destination 'platform=iOS Simulator,name=iPhone 17 Pro'",
    "verify:android": "cd android && ./gradlew clean build test",
    "check:wiring": "node scripts/check-wiring.mjs",
    "prepublishOnly": "pnpm run build",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@types/node": "^22.20.1",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
