{
  /*
   * The same sources typechecked against @capacitor/core 8 instead of the 7.x
   * copy the dev dependencies pin. `@capacitor/core-v8` is an npm alias for
   * @capacitor/core@^8, so both majors can be resolved side by side and the
   * published .d.ts is proven to describe an API that exists in each.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@capacitor/core": ["./node_modules/@capacitor/core-v8/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
